<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">🏆 功德排行榜</text>
    <text class="page-desc">精进修行，名列前茅</text>
  </view>

  <!-- 昵称设置提示 -->
  <view class="nickname-tip" wx:if="{{!hasNickname}}">
    <text class="tip-text">设置昵称，让其他修行者认识你</text>
    <text class="tip-btn" bindtap="goToSetNickname">去设置</text>
  </view>

  <!-- 我的排名卡片（始终显示在顶部） -->
  <view class="my-rank-card" wx:if="{{myRank}}">
    <view class="my-rank-badge">第 {{myRank.rank}} 名</view>
    <view class="my-rank-detail">
      <text class="my-rank-merit">⚜️ {{myRank.merit}} 功德</text>
      <text class="my-rank-power">💖 {{myRank.power}} 念力</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">师兄正在查榜...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && !loadError && rankingList.length === 0}}">
    <text class="empty-icon">📜</text>
    <text class="empty-text">暂无排行数据</text>
    <text class="empty-hint">快去敲木鱼成为第一名吧！</text>
  </view>

  <!-- 网络错误状态 -->
  <view class="error-state" wx:if="{{loadError && rankingList.length === 0}}">
    <text class="error-icon">⚠️</text>
    <text class="error-text">网络连接失败，请稍后重试</text>
    <view class="error-retry" bindtap="loadRanking">
      <text>重新加载</text>
    </view>
  </view>

  <!-- 排行榜列表 -->
  <view class="ranking-list" wx:if="{{!loading && !loadError && rankingList.length > 0}}">
    <view
      class="rank-item {{item.isMe ? 'is-me' : ''}} {{item.rank <= 3 ? 'top-' + item.rank : ''}}"
      wx:for="{{rankingList}}"
      wx:key="rank"
    >
      <!-- 排名徽章 -->
      <view class="rank-badge">
        <text class="rank-number" wx:if="{{item.rank > 3}}">{{item.rank}}</text>
        <text class="rank-medal" wx:if="{{item.rank === 1}}">🥇</text>
        <text class="rank-medal" wx:if="{{item.rank === 2}}">🥈</text>
        <text class="rank-medal" wx:if="{{item.rank === 3}}">🥉</text>
      </view>

      <!-- 用户头像 -->
      <view class="rank-avatar">
        <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="avatar-img" />
        <text wx:else class="avatar-placeholder">🧘</text>
      </view>

      <!-- 昵称和功德 -->
      <view class="rank-info">
        <text class="rank-nickname">{{item.nickName}}</text>
        <text class="rank-merit-label" wx:if="{{item.isMe}}">（我）</text>
      </view>

      <view class="rank-merit">
        <text class="merit-number">{{item.merit}}</text>
        <text class="merit-unit">功德</text>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="list-footer" wx:if="{{rankingList.length >= 100}}">
      <text class="footer-text">显示前 {{rankingList.length}} 名</text>
      <text class="footer-text" wx:if="{{myRank && myRank.rank > 100}}" style="margin-left: 16rpx;">| 你的排名：第 {{myRank.rank}} 名</text>
    </view>
    <!-- 总参与人数 -->
    <view class="list-footer" wx:if="{{totalUsers > 0 && rankingList.length < 100}}">
      <text class="footer-text">共 {{totalUsers}} 人参与修行</text>
    </view>
  </view>

  <!-- 刷新按钮 -->
  <view class="refresh-btn {{refreshing ? 'refresh-spin' : ''}}" bindtap="loadRanking" wx:if="{{!loading}}">
    <text class="refresh-icon">🔄</text>
    <text class="refresh-text">{{refreshing ? '刷新中...' : '刷新排行'}}</text>
  </view>
</view>
