/**
 * AI 聊天页面样式
 * 用户消息：右对齐，粉色气泡
 * AI 消息：左对齐，金色气泡
 */

.container {
  height: 100vh;
  background-color: #1a1a2e;
  display: flex;
  flex-direction: column;
}

/* ── 聊天滚动区域 ── */
.chat-scroll {
  flex: 1;
  padding: 20rpx 24rpx;
}

/* ── 欢迎提示 ── */
.welcome-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}

.welcome-avatar {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFD700;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.8;
}

.welcome-suggestions {
  margin-top: 40rpx;
  width: 100%;
}

.suggestion-title {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.suggestion-item {
  padding: 24rpx 24rpx;
  margin-bottom: 12rpx;
  background: #252540;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #ccc;
  text-align: center;
  border: 1rpx solid #333;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.suggestion-hover {
  background: #303050;
  border-color: #FFD700;
  color: #FFD700;
}

/* ── 消息项 ── */
.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-assistant {
  flex-direction: row;
}

/* ── 消息头像 ── */
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 32rpx;
}

/* ── 消息气泡 ── */
.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  word-break: break-all;
}

.bubble-assistant {
  background: #252540;
  border-top-left-radius: 6rpx;
  margin-left: 15rpx;
}

.bubble-user {
  background: linear-gradient(135deg, #FF69B4, #c94d8c);
  border-top-right-radius: 6rpx;
  margin-right: 15rpx;
}

.msg-content {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* ── 思考中动画 ── */
.thinking-bubble {
  padding: 30rpx 40rpx;
}

.thinking-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #888;
  animation: dotPulse 1.4s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1.2);
  }
}

/* ── 底部输入栏 ── */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #1a1a2e;
  border-top: 1rpx solid #333;
  gap: 16rpx;
}

.input-wrapper {
  flex: 1;
  background: #252540;
  border-radius: 40rpx;
  padding: 0 30rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.chat-input {
  width: 100%;
  height: 72rpx;
  font-size: 28rpx;
  color: #fff;
}

.send-btn {
  min-width: 120rpx;
  height: 72rpx;
  border-radius: 40rpx;
  background: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0 24rpx;
}

.send-btn text {
  font-size: 28rpx;
  color: #888;
}

.send-btn.active {
  background: linear-gradient(135deg, #FF69B4, #FFD700);
}

.send-btn.active text {
  color: #1a1a2e;
  font-weight: 600;
}

/* ── 底部留白 ── */
.chat-bottom-padding {
  height: 20rpx;
}
