/**
 * 我的页面样式
 * 用户信息卡片 + 功德统计 + 功能菜单
 */

.container {
  min-height: 100vh;
  background-color: #1a1a2e;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ── 用户信息卡片 ── */
.profile-card {
  margin: 30rpx 30rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #2a1a3e, #1a2a3e, #2a1a3e);
  opacity: 0.8;
}

.profile-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx 40rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 4rpx solid rgba(255, 215, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 60rpx;
}

.profile-name-wrap {
  margin-top: 20rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  height: 50rpx;
  line-height: 50rpx;
}

.profile-signature {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* ── 功德统计卡片 ── */
.stats-card {
  display: flex;
  margin: 30rpx 30rpx;
  background: #252540;
  border-radius: 20rpx;
  padding: 30rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-divider {
  width: 1rpx;
  background: #333;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.merit-number {
  color: #FFD700;
}

.power-number {
  color: #FF69B4;
}

.rank-number {
  color: #00CED1;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* ── 功能菜单 ── */
.menu-list {
  margin: 0 30rpx;
  background: #252540;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  min-height: 88rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: rgba(255, 255, 255, 0.04);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-text {
  font-size: 28rpx;
  color: #ddd;
}

.menu-arrow {
  font-size: 36rpx;
  color: #888;
}

/* ── 版本信息 ── */
.version-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  padding: 30rpx;
}

.version-text {
  font-size: 22rpx;
  color: #555;
}

.copyright-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
}

/* ── 加载动画 ── */
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 215, 0, 0.2);
  border-top-color: #FFD700;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 80rpx auto 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── 菜单项过渡 ── */
.menu-item {
  transition: background 0.15s ease;
}
