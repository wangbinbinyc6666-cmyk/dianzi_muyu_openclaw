/**
 * 我的页面样式
 * v4.0: 新增修行称号、连续签到卡片、分享弹窗
 */

.container {
  min-height: 100vh;
  background-color: #1a1a2e;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ── 用户信息卡片 ── */
.profile-card {
  margin: 30rpx 30rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #2a1a3e, #1a2a3e, #2a1a3e);
  opacity: 0.8;
}

.profile-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx 40rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 4rpx solid rgba(255, 215, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 60rpx;
}

.profile-name-wrap {
  margin-top: 20rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  height: 50rpx;
  line-height: 50rpx;
}

/* ── 修行称号 ── */
.profile-rank-title {
  margin-top: 12rpx;
  padding: 6rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(255, 105, 180, 0.08));
  border: 1rpx solid rgba(255, 215, 0, 0.25);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #FFD700;
  letter-spacing: 2rpx;
}

/* ── 功德统计卡片 ── */
.stats-card {
  display: flex;
  margin: 24rpx 30rpx;
  background: #252540;
  border-radius: 20rpx;
  padding: 30rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-divider {
  width: 1rpx;
  background: #333;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.merit-number {
  color: #FFD700;
}

.power-number {
  color: #FF69B4;
}

.rank-number {
  color: #00CED1;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* ── 修行记录卡片（签到天数 + 修行境界）── */
.streak-card {
  display: flex;
  margin: 0 30rpx 24rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.08), rgba(255, 105, 180, 0.04));
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  padding: 28rpx 10rpx;
}

.streak-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.streak-divider {
  width: 1rpx;
  background: rgba(255, 215, 0, 0.15);
}

.streak-num-streak {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFD700;
  margin-bottom: 8rpx;
}

.rank-title-text {
  font-size: 32rpx;
}

.streak-label {
  font-size: 24rpx;
  color: #999;
}

/* ── 分享按钮（清除 button 默认样式）── */
.share-native-btn {
  margin: 0;
  padding: 32rpx 30rpx;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: inherit;
  text-align: left;
}

.share-native-btn::after {
  border: none;
}

/* ── 功能菜单 ── */
.menu-list {
  margin: 0 30rpx;
  background: #252540;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  min-height: 88rpx;
  transition: background 0.15s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: rgba(255, 255, 255, 0.04);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #ddd;
}

.menu-arrow {
  font-size: 36rpx;
  color: #888;
}

/* ── 版本信息 ── */
.version-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
  padding: 30rpx;
}

.version-text {
  font-size: 22rpx;
  color: #555;
}

.copyright-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
}

/* ── 加载动画 ── */
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 215, 0, 0.2);
  border-top-color: #FFD700;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 80rpx auto 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ══════════════════════════════════════
   功德回向输入弹窗
   ══════════════════════════════════════ */

.dedicate-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease;
}

.dedicate-popup {
  width: 580rpx;
  background: linear-gradient(180deg, #2a2040, #1e1e36);
  border-radius: 32rpx;
  padding: 48rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.25);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dedicate-popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFD700;
  text-align: center;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.dedicate-popup-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
}

.dedicate-popup-input {
  width: 100%;
  height: 80rpx;
  background: #1a1a2e;
  border: 1rpx solid rgba(255, 215, 0, 0.2);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #fff;
  box-sizing: border-box;
}

.dedicate-popup-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.dedicate-popup-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.dedicate-popup-btn.cancel {
  background: #252540;
  color: #999;
  border: 1rpx solid #444;
}

.dedicate-popup-btn.confirm {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #1a1a2e;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 每日签到按钮徽章 */
.menu-badge {
  font-size: 20rpx;
  color: #FF6B6B;
  background: #FFE4E4;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}
