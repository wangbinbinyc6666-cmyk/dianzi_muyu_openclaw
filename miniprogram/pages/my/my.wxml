<view class="container">

  <!-- ═══ 功德回向输入弹窗 ═══ -->
  <view class="dedicate-overlay" wx:if="{{showDedicatePopup}}" catchtap="closeDedicatePopup">
    <view class="dedicate-popup" catchtap="">
      <view class="dedicate-popup-title">功德回向 🙏</view>
      <view class="dedicate-popup-desc">输入回向对象的名字，将功德回向给 TA</view>
      <input
        class="dedicate-popup-input"
        placeholder="例如：父母、朋友"
        placeholder-style="color:#666"
        value="{{dedicateInputValue}}"
        bindinput="onDedicateInput"
        focus="{{showDedicatePopup}}"
        confirm-type="done"
        bindconfirm="onDedicateMeritSubmit"
      />
      <view class="dedicate-popup-buttons">
        <view class="dedicate-popup-btn cancel" bindtap="closeDedicatePopup">取消</view>
        <view class="dedicate-popup-btn confirm" bindtap="onDedicateMeritSubmit">回向</view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="flex-column-center" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ═══ 用户信息卡片 ═══ -->
  <view class="profile-card" wx:if="{{!loading}}">
    <view class="profile-bg"></view>
    <view class="profile-content">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image
          class="profile-avatar"
          src="{{avatarUrl}}"
          mode="aspectFill"
          wx:if="{{avatarUrl}}"
        />
        <text class="avatar-placeholder" wx:else>🧘</text>
      </button>
      <view class="profile-name-wrap">
        <input
          class="profile-name"
          type="nickname"
          value="{{nickName}}"
          placeholder="点击设置昵称"
          placeholder-style="color: #888"
          bindblur="onNicknameBlur"
        />
      </view>
      <view class="profile-rank-title">🧘 {{rankTitle}}</view>
    </view>
  </view>

  <!-- ═══ 功德统计 ═══ -->
  <view class="stats-card" wx:if="{{!loading}}">
    <view class="stat-item">
      <text class="stat-number merit-number">{{merit}}</text>
      <text class="stat-label">总功德 ⚜️</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number power-number">{{power}}</text>
      <text class="stat-label">总念力 💖</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number rank-number">{{myRank}}</text>
      <text class="stat-label">排名 🏆</text>
    </view>
  </view>

  <!-- ═══ 修行记录卡片 ═══ -->
  <view class="streak-card" wx:if="{{!loading}}">
    <view class="streak-item">
      <text class="streak-num-streak">{{streakDays}}</text>
      <text class="streak-label">连续签到 🔥</text>
    </view>
    <view class="streak-divider"></view>
    <view class="streak-item">
      <text class="streak-num-streak rank-title-text">{{rankTitle}}</text>
      <text class="streak-label">修行境界 🧘</text>
    </view>
  </view>

  <!-- ═══ 功能菜单 ═══ -->
  <view class="menu-list">
    <!-- 每日签到按钮 -->
    <view class="menu-item" bindtap="onDailyCheckIn" hover-class="menu-item-hover">
      <view class="menu-left">
        <text class="menu-icon">📅</text>
        <text class="menu-text">每日签到</text>
        <text class="menu-badge" wx:if="{{!todayCheckedIn}}">领奖励</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 同步资料到排行榜 -->
    <view class="menu-item" bindtap="onSyncProfile" hover-class="menu-item-hover">
      <view class="menu-left">
        <text class="menu-icon">🔄</text>
        <text class="menu-text">同步资料到排行榜</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <button class="menu-item share-native-btn" open-type="share">
      <view class="menu-left">
        <text class="menu-icon">📤</text>
        <text class="menu-text">分享功德</text>
      </view>
      <text class="menu-arrow">›</text>
    </button>

    <view class="menu-item" bindtap="showDedicatePopup" hover-class="menu-item-hover">
      <view class="menu-left">
        <text class="menu-icon">🙏</text>
        <text class="menu-text">功德回向</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showAbout" hover-class="menu-item-hover">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于电子木鱼</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-list" style="margin-top: 16rpx;">
    <view class="menu-item" bindtap="goToPrivacy" hover-class="menu-item-hover">
      <view class="menu-left">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">隐私政策</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToAgreement" hover-class="menu-item-hover">
      <view class="menu-left">
        <text class="menu-icon">📋</text>
        <text class="menu-text">用户协议</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">电子木鱼 v2.0.0</text>
    <text class="copyright-text">🙏 愿功德与你同在</text>
  </view>
</view>
