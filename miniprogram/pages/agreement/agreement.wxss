.container {
  min-height: 100vh;
  background-color: #1a1a2e;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.content {
  padding: 40rpx 36rpx;
}

.section {
  margin-bottom: 36rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFD700;
  margin-bottom: 12rpx;
}

.update-date {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.body-text {
  display: block;
  font-size: 26rpx;
  color: #bbb;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
