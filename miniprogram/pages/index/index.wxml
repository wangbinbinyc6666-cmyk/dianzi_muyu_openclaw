<view class="container">

  <!-- ═══ 签到弹窗（首次进入触发）═══ -->
  <view class="checkin-overlay" wx:if="{{showCheckIn}}" catchtap="closeCheckIn" catchtouchmove="closeCheckIn">
    <view class="checkin-popup" catchtap="">
      <view class="checkin-icon">🙏</view>
      <view class="checkin-title">{{checkedIn ? '今日已签到' : '阿弥陀佛，今日签到'}}</view>
      <view class="checkin-streak" wx:if="{{checkedIn && streakDays > 0}}">
        连续签到 <text class="streak-num">{{streakDays}}</text> 天
      </view>
      <view class="checkin-reward" wx:if="{{checkedIn}}">
        获得 <text class="reward-num">2 + {{streakDays > 20 ? 20 : streakDays}}</text> 功德
      </view>
      <view class="checkin-sub" wx:if="{{!checkedIn}}">
        签到获得 2+ 功德，连续签到奖励翻倍
      </view>
      <view class="checkin-btn" bindtap="onCheckInTap" wx:if="{{!checkedIn}}" hover-class="btn-hover">
        立即签到
      </view>
      <view class="checkin-btn checked" bindtap="closeCheckIn" wx:else hover-class="btn-hover">
        今日已签到 ✓
      </view>
    </view>
  </view>

  <!-- ═══ 功德回向输入弹窗 ═══ -->
  <view class="dedicate-overlay" wx:if="{{showDedicatePopup}}" catchtap="closeDedicatePopup">
    <view class="dedicate-popup" catchtap="">
      <view class="dedicate-popup-title">功德回向 🙏</view>
      <view class="dedicate-popup-desc">输入回向对象的名字，将功德回向给 TA</view>
      <input
        class="dedicate-popup-input"
        placeholder="例如：父母、朋友"
        placeholder-style="color:#666"
        value="{{dedicateInputValue}}"
        bindinput="onDedicateInput"
        focus="{{showDedicatePopup}}"
        confirm-type="done"
        bindconfirm="onDedicateMeritSubmit"
      />
      <view class="dedicate-popup-buttons">
        <view class="dedicate-popup-btn cancel" bindtap="closeDedicatePopup">取消</view>
        <view class="dedicate-popup-btn confirm" bindtap="onDedicateMeritSubmit">回向</view>
      </view>
    </view>
  </view>

  <!-- ═══ 顶部横幅 ═══ -->
  <view class="header-banner">
    <text class="banner-text">阿弥陀佛，施主请敲木鱼</text>
  </view>

  <!-- ═══ 木鱼敲击区 ═══ -->
  <view class="woodfish-container" bindtap="onTapWoodfish">
    <view class="mallet-wrapper {{tapping ? 'mallet-strike' : ''}}">
      <image src="/images/mallet.png" mode="aspectFit" class="mallet-img" />
    </view>
    <view class="woodfish-wrapper {{tapping ? 'pressed' : ''}}">
      <image src="/images/woodfish.png" mode="aspectFit" class="woodfish-img" />
    </view>
    <view class="tap-hint">轻敲木鱼 · 积攒功德</view>
  </view>

  <!-- ═══ 修行称号 ═══ -->
  <view class="rank-title-bar">
    <text class="rank-title">🧘 {{rankTitle}}</text>
  </view>

  <!-- ═══ 数据面板 ═══ -->
  <view class="counters">
    <view class="counter-item">
      <text class="counter-label">功德</text>
      <text class="counter-value merit-value">{{merit}}</text>
      <text class="counter-desc">一敲一功德</text>
    </view>
    <view class="counter-divider"></view>
    <view class="counter-item">
      <text class="counter-label">念力</text>
      <text class="counter-value power-value">{{power}}</text>
      <text class="counter-desc">心诚则灵</text>
    </view>
  </view>

  <!-- ═══ 自动敲击 ═══ -->
  <view class="auto-tap-bar">
    <view class="auto-tap-btn {{autoTapping ? 'active' : ''}}" bindtap="toggleAutoTap">
      <text class="auto-tap-icon">{{autoTapping ? '⏸' : '▶'}}</text>
      <text class="auto-tap-label">{{autoTapping ? '停止积累功德' : '自动积累功德'}}</text>
    </view>
    <text class="auto-tap-speed" wx:if="{{autoTapping}}">积累功德中...</text>
  </view>

  <!-- ═══ 功能按钮 ═══ -->
  <view class="action-buttons">
    <view class="action-btn btn-ranking" bindtap="goToRanking" hover-class="btn-hover">
      <text class="btn-label">🏆 排行榜</text>
      <text class="btn-desc">修行精进</text>
    </view>
    <button class="action-btn btn-share share-native-btn" open-type="share">
      <text class="btn-label">📤 分享</text>
      <text class="btn-desc">广结善缘</text>
    </button>
  </view>

  <!-- ═══ 功德回向 + 今日进度 ═══ -->
  <view class="bottom-actions">
    <view class="dedicate-btn" bindtap="showDedicatePopup" hover-class="btn-hover">
      <text class="dedicate-icon">🙏</text>
      <text class="dedicate-text">功德回向</text>
      <text class="dedicate-sub">为他人祈福</text>
    </view>
    <view class="daily-progress">
      <view class="daily-progress-info">
        <text class="daily-progress-label">今日目标</text>
        <text class="daily-progress-num">{{todayMerit}} / {{dailyGoal}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill {{todayMerit >= dailyGoal ? 'full' : ''}}" style="width: {{todayMerit >= dailyGoal ? 100 : (todayMerit / dailyGoal * 100)}}%"></view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
