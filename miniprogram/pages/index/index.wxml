<view class="container">
  <view class="header-banner">
    <text class="banner-text">阿弥陀佛，施主请敲木鱼</text>
  </view>

  <view class="woodfish-container" bindtap="onTapWoodfish">
    <view class="woodfish-wrapper {{tapping ? 'pressed' : ''}}">
      <image src="/images/woodfish.png" mode="aspectFit" class="woodfish-img" />
    </view>
    <view class="tap-hint">轻敲木鱼 · 积攒功德</view>
  </view>

  <view class="counters">
    <view class="counter-item">
      <text class="counter-label">功德</text>
      <text class="counter-value merit-value">{{merit}}</text>
      <text class="counter-desc">一敲一功德</text>
    </view>
    <view class="counter-divider"></view>
    <view class="counter-item">
      <text class="counter-label">念力</text>
      <text class="counter-value power-value">{{power}}</text>
      <text class="counter-desc">心诚则灵</text>
    </view>
  </view>

  <view class="action-buttons">
    <view class="action-btn btn-ranking" bindtap="goToRanking" hover-class="btn-hover">
      <text class="btn-label">排行榜</text>
      <text class="btn-desc">修行精进</text>
    </view>
    <view class="action-btn btn-share" bindtap="onShare" hover-class="btn-hover">
      <text class="btn-label">分享功德</text>
      <text class="btn-desc">广结善缘</text>
    </view>
  </view>

  <view class="daily-tip">
    <text class="tip-text">今日已积 {{todayMerit}} 点功德</text>
  </view>

  <view class="safe-bottom"></view>
</view>
