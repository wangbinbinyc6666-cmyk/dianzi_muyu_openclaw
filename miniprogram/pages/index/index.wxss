/**
 * 首页 - 木鱼敲击
 * 核心交互：点击木鱼 → 动画 + 音效 + 震动 + 计数+1
 */

.container {
  min-height: 100vh;
  background-color: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

/* ── 顶部横幅 ── */
.header-banner {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(90deg, #FF69B4, #FFD700, #FF69B4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-text {
  color: #1a1a2e;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

/* ── 木鱼区域 ── */
.woodfish-container {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.woodfish-wrapper {
  width: 400rpx;
  height: 400rpx;
  transition: transform 0.1s ease-out;
  cursor: pointer;
}

/* 敲击动画：下沉后弹起 */
.woodfish-wrapper.tapping {
  transform: translateY(12rpx) scale(0.96);
}

/* 木鱼图片（正式替换占位符后使用） */
.woodfish-img {
  width: 400rpx;
  height: 400rpx;
}

/* 木鱼占位符样式 */
.woodfish-placeholder {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #8B6914, #5C3D0E);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.5),
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.1);
  border: 6rpx solid #A0781E;
  position: relative;
}

/* 木鱼纹理模拟 */
.woodfish-placeholder::before {
  content: '';
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 160rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.3);
}

.woodfish-emoji {
  font-size: 80rpx;
  filter: grayscale(30%);
}

.tap-hint {
  margin-top: 30rpx;
  color: #888;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* ── 计数器 ── */
.counters {
  display: flex;
  align-items: center;
  margin-top: 50rpx;
  width: 80%;
  background: #252540;
  border-radius: 24rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.counter-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.counter-divider {
  width: 2rpx;
  height: 80rpx;
  background: linear-gradient(to bottom, transparent, #444, transparent);
}

.counter-label {
  color: #aaa;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.counter-value-wrap {
  overflow: hidden;
}

.counter-value {
  font-size: 56rpx;
  font-weight: 800;
  transition: transform 0.15s ease-out;
  display: inline-block;
}

.merit-value {
  color: #FFD700;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.4);
}

.power-value {
  color: #FF69B4;
  text-shadow: 0 0 20rpx rgba(255, 105, 180, 0.4);
}

/* 数字变化时的弹出动画 */
.count-pop {
  animation: popIn 0.2s ease-out;
}

@keyframes popIn {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.counter-desc {
  margin-top: 8rpx;
  color: #666;
  font-size: 20rpx;
}

/* ── 功能按钮 ── */
.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 50rpx;
  width: 85%;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 10rpx;
  border-radius: 20rpx;
  transition: transform 0.15s;
}

.action-btn:active {
  transform: scale(0.95);
}

.btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 24rpx;
  font-weight: 500;
}

.btn-ai {
  background: linear-gradient(135deg, #FF69B4, #FF1493);
  color: #fff;
}

.btn-ranking {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #1a1a2e;
}

.btn-share {
  background: #333;
  color: #ccc;
}

/* ── 今日提示 ── */
.daily-tip {
  margin-top: 40rpx;
  padding: 16rpx 32rpx;
  background: rgba(255, 215, 0, 0.08);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.15);
}

.tip-text {
  color: #999;
  font-size: 22rpx;
}
