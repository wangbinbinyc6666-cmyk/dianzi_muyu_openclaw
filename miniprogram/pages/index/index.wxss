/**
 * 首页 - 木鱼敲击
 */

.container {
  min-height: 100vh;
  background-color: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 顶部横幅 ── */
.header-banner {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(90deg, #FF69B4, #FFD700, #FF69B4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-text {
  color: #1a1a2e;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

/* ── 木鱼区域 ── */
.woodfish-container {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.woodfish-wrapper {
  width: 400rpx;
  height: 400rpx;
  transition: opacity 0.12s ease-out;
}

/* 按压反馈：仅透明度变化，无布局偏移 */
.woodfish-wrapper.pressed {
  opacity: 0.75;
}

.woodfish-img {
  width: 400rpx;
  height: 400rpx;
}

.tap-hint {
  margin-top: 24rpx;
  color: #666;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* ── 计数器 ── */
.counters {
  display: flex;
  align-items: center;
  margin-top: 48rpx;
  width: 80%;
  background: #252540;
  border-radius: 24rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.counter-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.counter-divider {
  width: 2rpx;
  height: 64rpx;
  background: linear-gradient(to bottom, transparent, #444, transparent);
}

.counter-label {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.counter-value {
  font-size: 52rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.merit-value {
  color: #FFD700;
  text-shadow: 0 0 16rpx rgba(255, 215, 0, 0.35);
}

.power-value {
  color: #FF69B4;
  text-shadow: 0 0 16rpx rgba(255, 105, 180, 0.35);
}

.counter-desc {
  margin-top: 8rpx;
  color: #555;
  font-size: 20rpx;
}

/* ── 功能按钮 ── */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
  width: 85%;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 12rpx;
  border-radius: 20rpx;
}

.btn-hover {
  opacity: 0.8;
}

.btn-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.btn-desc {
  font-size: 20rpx;
  opacity: 0.7;
}

.btn-ai {
  background: linear-gradient(135deg, #FF69B4, #FF1493);
  color: #fff;
}

.btn-ranking {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #1a1a2e;
}

.btn-share {
  background: #2a2a40;
  color: #ccc;
}

/* ── 自动敲击开关 ── */
.auto-tap-bar {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.auto-tap-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 48rpx;
  border-radius: 48rpx;
  background: #2a2a40;
  border: 2rpx solid #444;
  transition: all 0.3s;
}

.auto-tap-btn.active {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-color: #FFD700;
}

.auto-tap-icon {
  font-size: 28rpx;
}

.auto-tap-label {
  font-size: 26rpx;
  color: #ccc;
}

.auto-tap-btn.active .auto-tap-label {
  color: #1a1a2e;
  font-weight: 600;
}

.auto-tap-speed {
  font-size: 22rpx;
  color: #FFD700;
  opacity: 0.8;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* ── 今日提示 ── */
.daily-tip {
  margin-top: 40rpx;
  padding: 16rpx 32rpx;
  background: rgba(255, 215, 0, 0.06);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.12);
}

.tip-text {
  color: #888;
  font-size: 22rpx;
}

/* ── 底部安全区 ── */
.safe-bottom {
  height: 32rpx;
}
