/**
 * 电子木鱼 - 全局样式
 * 配色：深紫黑背景 #1a1a2e | 金色 #FFD700 | 粉色 #FF69B4
 */

/* ── 全局重置 ── */
page {
  background-color: #1a1a2e;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ── 通用按钮样式 ── */
.btn-primary {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  background: linear-gradient(135deg, #FF69B4, #FFD700);
  color: #ffffff;
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-secondary {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: 2rpx solid #555;
  background: transparent;
  color: #cccccc;
  transition: border-color 0.2s ease, opacity 0.2s ease;
}

.btn-secondary:active {
  opacity: 0.85;
}

/* ── 卡片容器 ── */
.card {
  background: #252540;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
}

/* ── 滚动区域 ── */
.scroll-wrapper {
  height: 100%;
  overflow-y: auto;
}

/* ── 通用分隔线 ── */
.divider {
  width: 100%;
  height: 1rpx;
  background: #333;
}

/* ── 加载状态 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  margin-top: 20rpx;
  color: #888;
  font-size: 26rpx;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.6;
}

.empty-text {
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-hint {
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
}

/* ── 错误状态 ── */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.error-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.error-text {
  color: #FF69B4;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.error-retry {
  padding: 16rpx 40rpx;
  border-radius: 36rpx;
  background: rgba(255, 105, 180, 0.15);
  color: #FF69B4;
  font-size: 26rpx;
  border: 1rpx solid rgba(255, 105, 180, 0.3);
}

/* ── 全局 Toast 样式覆盖 ── */
.wx-toast {
  border-radius: 20rpx !important;
}

/* ── 单行文本溢出省略 ── */
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── flex 布局快捷类 ── */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── 法律页面公共样式（隐私政策 / 用户协议） ── */
.legal-container {
  min-height: 100vh;
  background-color: #1a1a2e;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.legal-content {
  padding: 40rpx 36rpx;
}

.legal-section {
  margin-bottom: 36rpx;
}

.legal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFD700;
  margin-bottom: 12rpx;
}

.legal-update-date {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.legal-subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.legal-body-text {
  display: block;
  font-size: 26rpx;
  color: #bbb;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
