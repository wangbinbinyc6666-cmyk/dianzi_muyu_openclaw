/**
 * 电子木鱼 - 全局样式
 * 配色：深紫黑背景 #1a1a2e | 金色 #FFD700 | 粉色 #FF69B4
 */

/* ── 全局重置 ── */
page {
  background-color: #1a1a2e;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ── 通用按钮样式 ── */
.btn-primary {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  background: linear-gradient(135deg, #FF69B4, #FFD700);
  color: #ffffff;
}

.btn-secondary {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: 2rpx solid #444;
  background: transparent;
  color: #cccccc;
}

/* ── 卡片容器 ── */
.card {
  background: #252540;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
}

/* ── 滚动区域 ── */
.scroll-wrapper {
  height: 100%;
  overflow-y: auto;
}

/* ── 通用分隔线 ── */
.divider {
  width: 100%;
  height: 1rpx;
  background: #333;
}

/* ── 加载状态 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  margin-top: 20rpx;
  color: #888;
  font-size: 26rpx;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.4;
}

.empty-text {
  margin-top: 20rpx;
  color: #888;
  font-size: 28rpx;
}

/* ── 全局 Toast 样式覆盖 ── */
.wx-toast {
  border-radius: 20rpx !important;
}

/* ── 单行文本溢出省略 ── */
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── flex 布局快捷类 ── */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}
